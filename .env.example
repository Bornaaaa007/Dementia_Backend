MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nestcare?appName=nestcare
PORT=5000

# Better Auth (generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
BETTER_AUTH_SECRET=change_me
# Use your computer's LAN IP when testing on a real phone, e.g. http://192.168.0.12:5000
BETTER_AUTH_URL=http://localhost:5000

# Web testing: exact address in the browser bar (comma separated)
CORS_ORIGINS=http://localhost:8081

# Set to false to disable the "sample data" buttons (use in production)
ALLOW_DEMO_DATA=true
